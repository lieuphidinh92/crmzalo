# ── Dependencies ─────────────────────────────────────────────────────
node_modules/
**/node_modules/
.pnpm-store/

# ── Build artifacts ─────────────────────────────────────────────────
dist/
**/dist/
build/
**/build/
out/
*.tsbuildinfo

# ── Environment / secrets ───────────────────────────────────────────
.env
.env.local
.env.*.local
**/.env
# MỌI biến thể .env (.env.prod, .env.staging...) — 3/8/2026 phát hiện
# backend/.env.prod chứa DATABASE_URL production mà KHÔNG bị ignore:
# một lần `git add .` là lộ mật khẩu Supabase lên GitHub.
.env.*
**/.env.*
# Ngoại lệ đứng SAU nên vẫn commit được file mẫu (luật sau thắng luật trước).
!.env.example
!**/.env.example

# ── Prisma generated client ─────────────────────────────────────────
backend/node_modules/.prisma/
backend/prisma/migrations/

# ── Logs ────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Runtime files ───────────────────────────────────────────────────
backups/
var/
backend/var/
*.pid
*.seed
*.pid.lock

# ── Test / coverage ─────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ── PWA generated icons (can be regenerated from favicon.svg) ──────
# Keep them in repo for now since they ship with the build.
# frontend/public/icons/

# ── Editor / OS ─────────────────────────────────────────────────────
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Misc ────────────────────────────────────────────────────────────
*.tgz
.npm/
.yarn-integrity
.cache/
