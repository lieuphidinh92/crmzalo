# === Zalo Sales CRM ===
PORT=3000
NODE_ENV=production
APP_URL=https://zalo.ngay.top

# Security — generate strong random values for production
JWT_SECRET=
ENCRYPTION_KEY=

# Database
DB_USER=crmuser
DB_PASSWORD=
DB_NAME=zalocrm
DATABASE_URL=postgresql://crmuser:password@db:5432/zalocrm

# Storage
UPLOAD_DIR=/var/lib/zalo-crm/files

# MISA AMIS Kế toán Open API — không commit giá trị thật
AMISKT_BASE_URL=https://developer.misa.vn/apis
AMISKT_CLIENT_ID=
AMISKT_ACCESS_CODE=
AMISKT_ORG_COMPANY_CODE=
AMISKT_CALLBACK_SECRET=

# AI (Phase 6)
# AI_PROVIDER=claude
